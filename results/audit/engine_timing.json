{
  "solver_file": "experiments/ode_v2/solver_candidate_rtol1e-8.json",
  "solver": {
    "_status": "DRAFT CANDIDATE, compared against solver_primary.json by scripts/calibrate_ode_classifier.py; not frozen, not run",
    "_rationale": {
      "rtol_atol": "100x tighter than solver_primary.json, so that a converged fixed point sits well below the classifier's fixed-point bounds instead of at them",
      "t_max_t_tail": "doubled from legacy with the tail kept at the final third, because lower Hill coefficients may settle more slowly; tail_range and final_derivative will show whether this suffices",
      "attempts": "RK45 first; a larger RK45 budget only if the first hit its cap; an implicit stiff method only after a failure of any kind (2026-09-21 code review). Radau versus BDF to be chosen by benchmark before the freeze."
    },
    "attempts": [
      {
        "method": "RK45",
        "max_rhs_evals": 200000,
        "when": "first"
      },
      {
        "method": "RK45",
        "max_rhs_evals": 2000000,
        "when": "after_cap"
      },
      {
        "method": "Radau",
        "max_rhs_evals": 2000000,
        "when": "after_failure"
      }
    ],
    "rtol": 1e-08,
    "atol": 1e-10,
    "max_step": 2.0,
    "t_max": 60.0,
    "t_tail": 20.0,
    "n_tail_samples": 100
  },
  "classifier_file": "experiments/ode_v2/classifier_primary.json",
  "classifier": {
    "_status": "DRAFT, proposed for the registration, not frozen, not run",
    "_rationale": {
      "fixed": "tail range and final derivative thresholds from the 2026-09-21 code review; at rtol 1e-6 they sit at the solver's noise floor and reject converged fixed points, at rtol 1e-8 converged fixed points fall 10x inside them (results/audit/classifier_calibration*.json)",
      "oscillatory": "tail range above 1e-4, inside [0, 1] up to the margin, and each half of the tail repeating the other's per-node maximum and minimum to within 5% of that node's range; nodes whose range is within the fixed-point bound count as static and are not compared",
      "extension_horizons": "60 -> 120 -> 240 -> 480 -> 960, the tail kept at the final third of each horizon and sampled at constant density. 480 and 960 were added after calibration found damped oscillations near a Hopf point (arabidopsis_cellcycle, n_H = 2) that settle only by t ~ 400-800 (results/audit/classifier_calibration_rtol1e-8_arabidopsis_n2.json)"
    },
    "fixed_tail_range_max": 1e-05,
    "fixed_derivative_max": 1e-06,
    "oscillatory_tail_range_min": 0.0001,
    "halves_envelope_tol": 0.05,
    "bounded_margin": 0.001,
    "extension_horizons": [
      120.0,
      240.0,
      480.0,
      960.0
    ]
  },
